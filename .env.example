EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay production RuName, not a URL
EBAY_REDIRECT_URI=
# 32 random bytes encoded as 64 hexadecimal characters
EBAY_TOKEN_KEY=
# Public Cloudflare Worker origin and matching RELAY_SECRET
EBAY_RELAY_URL=
EBAY_RELAY_SECRET=

# Public shop (Node host with persistent DATA_DIR; HTTPS required in production)
SHOP_URL=http://127.0.0.1:3000
# Set your actual UK shipping charge in pence; checkout stays disabled until set
SHOP_SHIPPING_PENCE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=

# Laravel admin: persist both keys across deployments and inventory migration.
LARAVEL_APP_KEY=
ADMIN_SERVICE_KEY=
LARAVEL_ADMIN_EMAIL=admin@togacards.co.uk

# Customer password-reset email delivery (configure on the server; never commit credentials).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@togacards.co.uk
MAIL_FROM_NAME=Toga Cards
