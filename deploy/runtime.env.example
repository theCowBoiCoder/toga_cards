# Installed outside Git as /etc/toga-cards/runtime.env (root:root, 0600).
# Literal KEY=value format, no quotes or shell interpolation.
SHOP_URL=https://togacards.co.uk
ADMIN_USER=admin
ADMIN_PASSWORD=
SHOP_SHIPPING_PENCE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
# Preserve the existing key exactly when migrating encrypted seller tokens.
EBAY_TOKEN_KEY=
EBAY_RELAY_URL=
EBAY_RELAY_SECRET=

# Laravel admin: persist both keys across deployments and inventory migration.
LARAVEL_APP_KEY=
ADMIN_SERVICE_KEY=
LARAVEL_ADMIN_EMAIL=admin@togacards.co.uk
